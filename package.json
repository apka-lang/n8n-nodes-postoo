{
	"name": "n8n-nodes-postoo",
	"version": "0.1.1",
	"description": "n8n node for Postoo — publish posts to LinkedIn, Facebook, Instagram, TikTok, and more via the Postoo API.",
	"keywords": [
		"n8n-community-node-package",
		"postoo",
		"social-media",
		"publishing",
		"linkedin",
		"instagram",
		"facebook",
		"tiktok"
	],
	"license": "MIT",
	"homepage": "https://github.com/apka-lang/n8n-nodes-postoo#readme",
	"author": {
		"name": "apka-lang",
		"email": "kontakt@postoo.pl",
		"url": "https://github.com/apka-lang"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/apka-lang/n8n-nodes-postoo"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"format": "prettier --write credentials nodes tests *.json *.js *.md",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "npm run build && node --test tests/*.test.js",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/PostooApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Postoo/Postoo.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.55.4",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
